# Victory Genomics CRM — now a MOUNTED module inside the VGold unified app.
# The CRM is never served standalone anymore: every /crm/* request must be
# funnelled up to the VGold front controller (../public/index.php), which
# boots the unified session bridge (crm/mount.php) so there is ONE login.
#
# This file DELIBERATELY overrides the legacy CRM routing (which used
# `DirectoryIndex login.php` + ErrorDocument /login.php and made /crm/ serve
# crm/login.php directly, bypassing the mount and showing a second login).

RewriteEngine On
RewriteBase /crm/

# Force HTTPS (SiteGround free SSL).
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# No directory listings and, crucially, do NOT auto-serve login.php/index.php
# for a bare /crm/ directory request — let the rewrite below take it to the
# unified front controller instead.
Options -Indexes
DirectoryIndex disabled

# Protect sensitive files (defense in depth; root .htaccess also blocks these).
<FilesMatch "\.env(\.\w+)?$">
    Require all denied
</FilesMatch>
<FilesMatch "^(database\.php|config\.php)$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(sql|db|sqlite)$">
    Require all denied
</FilesMatch>
<Files "*.log">
    Require all denied
</Files>
<FilesMatch "^VG_.*\.csv$">
    Require all denied
</FilesMatch>
RedirectMatch 404 /\.git

# ── Funnel everything through the VGold front controller ─────────────────────
# Serve real static assets that physically exist under crm/ directly (css, js,
# images, fonts, uploaded media) — the mount also handles these, but letting
# Apache serve existing files is faster and avoids a PHP round-trip.
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_URI} \.(css|js|mjs|map|png|jpe?g|gif|svg|webp|ico|woff2?|ttf|eot|pdf|mp4|mp3|ogg|wav|webm|docx?|xlsx?|pptx?)$ [NC]
RewriteRule ^ - [L]

# Everything else under /crm/* (including the bare /crm/ directory, all .php
# pages, and the API endpoints) goes to the unified front controller, which
# require's crm/mount.php. Use an absolute filesystem path up one level.
RewriteRule ^ /public/index.php [QSA,L]

# Security headers.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
